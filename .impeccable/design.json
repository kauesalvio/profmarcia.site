      "css": ".ds-btn-secondary{display:inline-flex;min-height:48px;align-items:center;justify-content:center;padding:12px 20px;border:2px solid var(--color-tinta);border-radius:var(--radius-2xl);background:var(--color-creme);color:var(--color-marinho);box-shadow:var(--shadow-sm);font:900 14px/1.5 var(--font-nunito),sans-serif;transition:transform 150ms,background-color 150ms;cursor:pointer}.ds-btn-secondary:hover{background:var(--color-creme-2);transform:translateY(-2px)}.ds-btn-secondary:active{transform:none}.ds-btn-secondary:focus-visible{outline:3px solid var(--color-amarelo);outline-offset:3px}"
    },
