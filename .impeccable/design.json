      "css": ".ds-btn-danger{display:inline-flex;min-height:48px;align-items:center;justify-content:center;padding:12px 20px;border:2px solid var(--color-tinta);border-radius:var(--radius-2xl);background:var(--color-coral);color:var(--color-marinho);box-shadow:var(--shadow-sm);font:900 14px/1.5 var(--font-nunito),sans-serif;transition:transform 150ms,background-color 150ms;cursor:pointer}.ds-btn-danger:hover{background:var(--color-error-bg);transform:translateY(-2px)}.ds-btn-danger:active{transform:none}.ds-btn-danger:focus-visible{outline:3px solid var(--color-amarelo);outline-offset:3px}"
    },
    {
      "name": "Card de Bancada",
      "kind": "card",
      "refersTo": "card",
      "description": "Superfície canônica para conteúdo e operações.",
      "html": "<article class=\"ds-card\"><h3>Atividades</h3><p>Veja, edite e organize o que já foi criado.</p></article>",
      "css": ".ds-card{padding:20px;border:3px solid var(--color-tinta);border-radius:var(--radius-3xl);background:var(--color-creme);color:var(--color-marinho);box-shadow:var(--shadow-md);font:600 16px/1.5 var(--font-nunito),sans-serif;transition:transform 150ms,box-shadow 150ms}.ds-card:hover{transform:translateY(-4px);box-shadow:var(--shadow-lg)}.ds-card h3{margin:0 0 8px;font:900 24px/.95 var(--font-archivo),sans-serif;letter-spacing:-.01em;text-transform:uppercase}.ds-card p{margin:0;color:var(--color-gray-600)}.ds-card:focus-within{outline:3px solid var(--color-amarelo);outline-offset:3px}"
