      "html": "<span class=\"ds-badge\">Quiz</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:4px;padding:4px 8px;border:2px solid var(--color-tinta);border-radius:var(--radius-lg);background:var(--color-lima);color:var(--color-marinho);font:900 11px/1.5 var(--font-nunito),sans-serif;letter-spacing:.1em;text-transform:uppercase}.ds-badge:focus-visible{outline:3px solid var(--color-amarelo);outline-offset:3px}"
    },
    {
      "name": "Navegação da Professora",
      "kind": "nav",
      "description": "Quatro rotas sempre visíveis em grade no celular e fileira em telas maiores.",
      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-active\" href=\"#\">Bancada</a><a href=\"#\">Turmas</a><a href=\"#\">Atividades</a><a href=\"#\">Respostas</a></nav>",
      "css": ".ds-nav{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:4px;padding:0 16px 12px;background:var(--color-marinho);font:700 11px/1.5 var(--font-nunito),sans-serif}.ds-nav a{display:flex;min-height:44px;align-items:center;justify-content:center;padding:0 4px;border:2px solid color-mix(in oklch,var(--color-creme) 20%,transparent);border-radius:var(--radius-2xl) var(--radius-2xl) var(--radius-sm) var(--radius-sm);color:color-mix(in oklch,var(--color-creme) 70%,transparent);text-decoration:none;white-space:nowrap}.ds-nav a:hover{background:var(--color-marinho-2);color:var(--color-creme)}.ds-nav .ds-nav-active{border-color:var(--color-tinta);background:var(--color-creme);color:var(--color-marinho);box-shadow:var(--shadow-sm)}.ds-nav a:focus-visible{outline:3px solid var(--color-amarelo);outline-offset:3px}@media(min-width:640px){.ds-nav{display:flex;flex-wrap:wrap;gap:8px}.ds-nav a{padding:0 16px;font-size:14px}}"
    },
    {
      "name": "Alerta de Erro",
      "kind": "custom",
      "description": "Feedback textual, tonal e acompanhado por símbolo próprio.",
      "html": "<div class=\"ds-alert\" role=\"alert\"><span class=\"ds-alert-icon\" aria-hidden=\"true\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 7.5v5\"/><path d=\"M12 16.5h.01\"/><path d=\"M10.1 3.9 2.8 17a2 2 0 0 0 1.8 3h14.8a2 2 0 0 0 1.8-3L13.9 3.9a2.2 2.2 0 0 0-3.8 0Z\"/></svg></span><span>Não foi possível carregar. Tente novamente.</span></div>",
      "css": ".ds-alert{display:flex;align-items:center;gap:12px;padding:12px 16px;border:2px solid var(--color-tinta);border-radius:var(--radius-2xl);background:var(--color-error-bg);color:var(--color-marinho);box-shadow:var(--shadow-sm);font:700 14px/1.5 var(--font-nunito),sans-serif}.ds-alert-icon{display:grid;width:28px;height:28px;flex:none;place-items:center;border-radius:9999px;background:var(--color-marinho);color:var(--color-creme)}.ds-alert:focus-within{outline:3px solid var(--color-amarelo);outline-offset:3px}"
    },
