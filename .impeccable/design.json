      "css": ".ds-poster-pill{display:inline-flex;align-items:center;gap:8px;padding:5px 13px;border:2px solid var(--color-tinta);border-radius:var(--radius-md);background:var(--color-amarelo);color:var(--color-marinho);box-shadow:var(--shadow-sm);font:900 12px/1.5 var(--font-nunito),sans-serif;letter-spacing:.08em;text-transform:uppercase}.ds-poster-pill:hover{transform:rotate(-1deg)}.ds-poster-pill:focus-visible{outline:3px solid var(--color-amarelo);outline-offset:3px}"
    }
