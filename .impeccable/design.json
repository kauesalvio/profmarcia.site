      "html": "<label class=\"ds-field\"><span>E-mail</span><input type=\"email\" placeholder=\"professora@escola.com\"></label>",
      "css": ".ds-field{display:flex;flex-direction:column;gap:6px;color:var(--color-tinta);font:900 14px/1.5 var(--font-nunito),sans-serif}.ds-field input{min-height:48px;padding:10px 16px;border:2px solid var(--color-tinta);border-radius:var(--radius-xl);background:var(--color-creme);color:var(--color-marinho);box-shadow:var(--shadow-sm);font:700 16px/1.5 var(--font-nunito),sans-serif;transition:transform 150ms,border-color 150ms}.ds-field input:hover{transform:translateY(-1px)}.ds-field input:focus-visible{transform:none;border-color:var(--color-eletrico);outline:3px solid var(--color-amarelo);outline-offset:3px}.ds-field input:disabled{background:var(--color-creme-2);color:var(--color-gray-500)}"
    },
    {
