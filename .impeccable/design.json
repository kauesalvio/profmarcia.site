  "components": [
    {
      "name": "Botão Primário",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ação dominante de qualquer fluxo, amarela e tátil.",
      "html": "<button class=\"ds-btn-primary\">Criar atividade</button>",
      "css": ".ds-btn-primary{display:inline-flex;min-height:48px;align-items:center;justify-content:center;gap:8px;padding:12px 20px;border:2px solid var(--color-tinta);border-radius:var(--radius-2xl);background:var(--color-amarelo);color:var(--color-marinho);box-shadow:var(--shadow-sm);font:900 14px/1.5 var(--font-nunito),sans-serif;letter-spacing:.025em;transition:transform 150ms,box-shadow 150ms,background-color 150ms;cursor:pointer}.ds-btn-primary:hover{background:var(--color-sun-light);transform:translateY(-2px)}.ds-btn-primary:active{transform:none}.ds-btn-primary:focus-visible{outline:3px solid var(--color-amarelo);outline-offset:3px}"
    },
    {
      "name": "Botão do Aluno",
      "kind": "button",
      "refersTo": "button-student",
      "description": "Ação de início ou avanço no percurso do aluno.",
      "html": "<button class=\"ds-btn-student\">Começar →</button>",
      "css": ".ds-btn-student{display:inline-flex;min-height:56px;align-items:center;justify-content:center;gap:8px;padding:16px 28px;border:2px solid var(--color-tinta);border-radius:var(--radius-2xl);background:var(--color-lima);color:var(--color-marinho);box-shadow:var(--shadow-sm);font:900 16px/1.5 var(--font-nunito),sans-serif;transition:transform 150ms,background-color 150ms;cursor:pointer}.ds-btn-student:hover{background:var(--color-student-light);transform:translateY(-2px)}.ds-btn-student:active{transform:none}.ds-btn-student:focus-visible{outline:3px solid var(--color-amarelo);outline-offset:3px}"
    },
    {
      "name": "Botão Secundário",
      "kind": "button",
      "refersTo": "button-secondary",
